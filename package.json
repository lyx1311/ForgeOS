{
  "name": "forgeos",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:broker": "tsx watch src/broker.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "start:broker": "node dist/src/broker.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "replay": "node dist/src/replay.js",
    "smoke:live": "node scripts/live-model-smoke.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.2.0",
    "dockerode": "^5.0.1",
    "fastify": "^5.5.0",
    "tar-fs": "^3.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.43",
    "@types/node": "^24.3.0",
    "@types/tar-fs": "^2.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
